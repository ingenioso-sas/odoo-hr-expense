<odoo>
    <record id="view_hr_expense_sheet_form" model="ir.ui.view">
        <field name="name">hr.expense.sheet.form.payroll.channel</field>
        <field name="model">hr.expense.sheet</field>
        <field name="inherit_id" ref="hr_expense.view_hr_expense_sheet_form" />
        <field name="arch" type="xml">
            <field name="payment_mode" position="after">
                <field name="payment_channel" />
                <field
                    name="amount_to_pay"
                    groups="account.group_account_user"
                    attrs="{'invisible': [('payment_mode', '!=', 'own_account')]}"
                />
            </field>
            <xpath
                expr="//header/button[@name='%(hr_expense.hr_expense_sheet_register_payment_wizard_action)d']"
                position="attributes"
            >
                <attribute
                    name="attrs"
                >{'invisible': ['|', ('state', '!=', 'post'), ('payment_channel', '=', 'payroll')]}</attribute>
            </xpath>
            <field name="account_move_id" position="after">
                <field
                    name="payslip_ids"
                    widget="many2many_tags"
                    readonly="1"
                    groups="account.group_account_user"
                />
            </field>
        </field>
    </record>
</odoo>
