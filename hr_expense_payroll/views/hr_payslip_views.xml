<odoo>
    <record id="view_hr_payslip_form" model="ir.ui.view">
        <field name="name">hr.payslip.form.expense.bridge</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll_community.view_hr_payslip_form" />
        <field name="arch" type="xml">
            <xpath expr="(//notebook/page)[last()]" position="inside">
                <group string="Expense Reimbursements">
                    <field
                        name="expense_sheet_ids"
                        widget="many2many_tags"
                        readonly="1"
                    />
                    <field name="reversed_move_id" readonly="1" />
                    <field name="reversal_move_id" readonly="1" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
